{
  "name": "bm2q",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch server.ts",
    "dev:split": "concurrently \"next dev --turbopack\" \"tsx watch src/server/index.ts\"",
    "dev:client": "next dev --turbopack",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "next build && npx tsc -p tsconfig.server.json",
    "start": "node dist/server.js",
    "serve": "tsx src/server/index.ts",
    "lint": "next lint"
  },
  "dependencies": {
    "@colyseus/schema": "^2.0.35",
    "@colyseus/ws-transport": "^0.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "colyseus": "^0.15.0",
    "colyseus.js": "^0.15.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.0.9",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.2"
  },
  "overrides": {
    "nanoid@2": "3.3.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "autoprefixer": "^10.4.20"
  }
}

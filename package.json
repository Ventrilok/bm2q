{
  "name": "bm2q",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch server.ts",
    "dev:split": "concurrently \"next dev --turbopack\" \"tsx watch src/server/index.ts\"",
    "dev:client": "next dev --turbopack",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "next build && npx tsc -p tsconfig.server.json",
    "start": "node dist/server.js",
    "serve": "tsx src/server/index.ts",
    "lint": "next lint",
    "test": "BM2Q_READY_DELAY_MS=400 BM2Q_RECAP_DELAY_MS=100 BM2Q_RECONNECT_SECONDS=1 LOG_LEVEL=warn node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test:smoke": "LOG_LEVEL=warn node --import tsx --test tests/smoke/*.test.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.23",
    "@colyseus/schema": "^5.0.42",
    "@colyseus/sdk": "^0.18.6",
    "@colyseus/ws-transport": "^0.18.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "nanoid": "^3.3.11",
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.2"
  },
  "overrides": {},
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
